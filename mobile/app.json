{
  "expo": {
    "name": "LUXIPANEL",
    "slug": "luxipanel-mobile",
    "version": "2.0.2",
    "scheme": "luxipanel",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#151c2c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.luxipanel",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "El asistente IA del panel usa el micrófono para dictar mensajes por voz."
      }
    },
    "android": {
      "package": "com.example.luxipanel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#151c2c"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "com.android.vending.BILLING",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "El asistente IA del panel usa el micrófono para dictar mensajes por voz."
        }
      ],
      "react-native-iap",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "LUXIPANEL usa el micrófono para llamadas y mensajes de voz.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MICROPHONE"
          ],
          "androidForegroundService": true,
          "androidFSTypes": [
            "microphone"
          ]
        }
      ]
    ]
  }
}
