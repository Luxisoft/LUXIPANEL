{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "node": "22.22.2",
      "pnpm": "11.22.0",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "node": "22.22.2",
      "pnpm": "11.22.0",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "production": {
      "node": "22.22.2",
      "pnpm": "11.22.0",
      "autoIncrement": true,
      "environment": "production"
    },
    "production-apk": {
      "node": "22.22.2",
      "pnpm": "11.22.0",
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      },
      "ios": {
        "ascApiKeyPath": "./credentials/asc-api-key.p8",
        "ascApiKeyId": "REEMPLAZAR_ASC_API_KEY_ID",
        "ascApiKeyIssuerId": "REEMPLAZAR_ASC_API_KEY_ISSUER_ID",
        "ascAppId": "REEMPLAZAR_ASC_APP_ID"
      }
    }
  }
}
