{
  "name": "luxipanel-mobile",
  "version": "2.0.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:env:push:dev": "node scripts/sync-eas-env.mjs development",
    "eas:env:push:preview": "node scripts/sync-eas-env.mjs preview",
    "eas:env:push:prod": "node scripts/sync-eas-env.mjs production",
    "build:dev": "node scripts/sync-eas-env.mjs development && bash scripts/eas.sh build --profile development --platform android",
    "build:preview": "bash scripts/eas.sh build --profile preview --platform android",
    "release:patch": "node scripts/bump-expo-version-patch.js",
    "version:patch": "node scripts/bump-expo-version-patch.js",
    "build:prod": "node scripts/sync-eas-env.mjs production && bash scripts/eas.sh build --profile production --platform android",
    "build:prod:submit": "node scripts/sync-eas-env.mjs production && bash scripts/eas.sh build --profile production --platform android --auto-submit",
    "build:prod-apk": "node scripts/sync-eas-env.mjs production && bash scripts/eas.sh build --profile production-apk --platform android",
    "submit:prod": "bash scripts/eas.sh submit --profile production --platform android",
    "build:dev:ios": "node scripts/sync-eas-env.mjs development && bash scripts/eas.sh build --profile development --platform ios",
    "build:preview:ios": "node scripts/sync-eas-env.mjs preview && bash scripts/eas.sh build --profile preview --platform ios",
    "build:prod:ios": "node scripts/sync-eas-env.mjs production && bash scripts/eas.sh build --profile production --platform ios",
    "build:prod:submit:ios": "node scripts/sync-eas-env.mjs production && bash scripts/eas.sh build --profile production --platform ios --auto-submit",
    "submit:prod:ios": "bash scripts/eas.sh submit --profile production --platform ios",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "dependencies": {
    "@dicebear/avataaars": "9.4.2",
    "@dicebear/core": "9.4.2",
    "@expo/app-integrity": "55.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@shopify/react-native-skia": "2.2.12",
    "@tolqia/client": "file:vendor/tolqia-client-1.2.0.tgz",
    "@tolqia/contracts": "file:vendor/tolqia-contracts-1.2.0.tgz",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/headless": "6.0.0",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.0",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.16",
    "expo-font": "14.0.11",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.6",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^10.7.0",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-audio-api": "0.12.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-iap": "15.2.4",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-passkey": "^3.1.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-static-block": "7.28.6",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eas-cli": "^20.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.8"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.5.0"
}
