{
  "name": "luxipanel-backend",
  "version": "2.0.3",
  "description": "LUXIPANEL — Modern server administration panel backend (Modular Monolith)",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "@config/*": "./dist/config/*",
    "@shared/*": "./dist/shared/*",
    "@modules/*": "./dist/modules/*"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm run build:cache-policy && tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths && node scripts/copy-runtime-assets.mjs && node scripts/verify-runtime-imports.mjs && cp package.json dist/ && cp pnpm-lock.yaml dist/ && cp tsconfig.json dist/",
    "build:cache-policy": "tsx scripts/remote/build-policy.ts",
    "redeploy": "pnpm run build && pm2 restart luxipanel-backend --update-env",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deps:check": "pnpm dlx --package typescript@5.8.3 --package knip@5.30.6 knip --config knip.json --dependencies --no-progress",
    "deps:fix": "pnpm dlx --package typescript@5.8.3 --package knip@5.30.6 knip --config knip.json --dependencies --no-progress --fix",
    "deps:dedupe": "pnpm dedupe",
    "deps:prune": "pnpm prune --prod"
  },
  "packageManager": "pnpm@11.5.0",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@otplib/plugin-base32-scure": "^13.4.0",
    "@otplib/plugin-crypto-noble": "^13.4.0",
    "@rollup/rollup-linux-x64-gnu": "^4.60.1",
    "@simplewebauthn/server": "^10.0.1",
    "@simplewebauthn/types": "^10.0.0",
    "@toon-format/toon": "4.4.0",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "imapflow": "^1.0.177",
    "ioredis": "^5.6.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.7.2",
    "node-pty": "^1.0.0",
    "nodemailer": "^10.0.2",
    "openpgp": "^6.3.2",
    "otplib": "^13.4.0",
    "pg": "8.23.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "rate-limit-redis": "^4.2.0",
    "sanitize-html": "^2.17.6",
    "ssh2": "^1.17.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "8.15.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.24.0",
    "globals": "^17.7.0",
    "supertest": "^7.1.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
