# ================================
# LUXIPANEL local Docker settings
# ================================

# Compose ports on host
PORT=8080
FRONTEND_PORT=4321
DB_PORT=5432
REDIS_PORT=56379

# Docker services
POSTGRES_PASSWORD=

# Backend runtime
#NODE_ENV=production
NODE_ENV=production
HOST=127.0.0.1
LOG_LEVEL=info

# PostgreSQL fue removido. LUXIPANEL persiste todo como JSON en
# ${LUXIPANEL_CONFIG_DIR} sobre el servidor conectado (kv-store).
LUXIPANEL_CONFIG_DIR=/etc/luxipanel/
# Consulta local de chats Luxisoft, solo lectura; toma DATABASE_URL del backend Luxisoft.
LUXISOFT_CHAT_DATABASE_ENV_FILE=/var/www/luxisoft/backend/.env
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# Frontend origin for CORS (browser -> host mapped port)
CORS_ORIGIN=https://luxipanel.com
CORS_CREDENTIALS=true

# Auth (min 32 chars required)
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=30d
COOKIE_DOMAIN=.luxipanel.com
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=luxipanel_session
CSRF_COOKIE_NAME=luxipanel_csrf

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# hCaptcha (disabled for local)
HCAPTCHA_ENABLED=false
HCAPTCHA_SECRET=
HCAPTCHA_SITEKEY=

# Passkeys local setup
WEBAUTHN_RP_NAME=LUXIPANEL
WEBAUTHN_RP_ID=luxipanel.com
WEBAUTHN_ORIGIN=https://luxipanel.com

# Mail integration defaults
DOVECOT_USERS_FILE=/etc/dovecot/users
DOVECOT_GROUP=dovecot
VMAIL_BASE=/var/vmail
VMAIL_UID=5000
VMAIL_GID=5000
SIEVEC_BIN=/usr/bin/sievec
POSTFIX_VMAILBOX=/etc/postfix/vmailbox
MAIL_ENCRYPTION_KEY=

# AI (optional)
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ================================
# STANDALONE SELF-HOSTING — bóveda de servidores remotos (multi-nodo SSH)
# ================================
# LUXIPANEL administra servidores por SSH directo. El portal LP solo valida la
# API KEY de esta instalación para módulos dev, comunidad, actualizaciones Git
# de repositorios clonados y soporte. Obtén la clave en luxipanel.com/portal/servers
# → Seguridad → API KEY. Un administrador también puede pegarla en el botón
# API KEY de la barra superior; se guarda en LUXIPANEL_CONFIG_DIR con modo 0600
# y prevalece sobre este valor. Sin clave o sin conexión
# al portal, esas funciones quedan bloqueadas; el resto del panel funciona.
LP_PANEL_CREDENTIAL=
LICENSE_SERVER_URL=https://api.luxisoft.com
# Tras editar .env: pm2 restart /ruta/LUXIPANEL/ecosystem.config.cjs --only luxipanel-backend --update-env

# Clave maestra de la BÓVEDA LOCAL de credenciales de servidores remotos
# (modules/servers → ${LUXIPANEL_CONFIG_DIR}/servers/targets.json, 0600).
# Cifrado AES-256-GCM en reposo con clave derivada por HKDF-SHA256.
# OBLIGATORIA EN PRODUCCIÓN: 64 hex (32 bytes). Genérala con:
#   openssl rand -hex 32
# Si se deja vacía fuera de producción, se deriva de JWT_SECRET (con un warning
# al primer uso). ⚠️ Si esta clave cambia, la bóveda existente deja de descifrar:
# trátala como secreto raíz y haz backup.
CREDENTIAL_VAULT_KEY=

# Relaja la política SSRF para administrar servidores de tu PROPIA LAN
# (RFC1918 / loopback / link-local / CGNAT). Por defecto false = se bloquean los
# rangos privados tras resolver DNS. Ponla true SOLO en una caja que legítimamente
# administra servidores en su red local. La metadata cloud (169.254.169.254) y
# los rangos multicast/reservados siguen bloqueados en ambos casos.
SERVERS_ALLOW_PRIVATE=

# Terminal
TERMINAL_ENABLED=true
TERMINAL_MAX_SESSIONS=5
TERMINAL_IDLE_TIMEOUT_MS=1800000
TERMINAL_SHELL=/bin/bash

# File Manager allowed base directories (comma-separated)
FILE_MANAGER_BASES=/,/var,/home,/etc,/opt

# i18n
# DEFAULT_LOCALE debe ser uno de los 12 idiomas de frontend/src/i18n/config.ts
DEFAULT_LOCALE=en
# Release manager: optional while the GitHub repository is public.
# For a private repository use a read-only token for Luxisoft/LUXIPANEL.
LUXIPANEL_GITHUB_TOKEN=
# Override only if the original checkout is not the parent of backend/.
LUXIPANEL_INSTALL_ROOT=
# SUPPORTED_LOCALES = todos los idiomas disponibles (12 locales en frontend/src/i18n)
SUPPORTED_LOCALES=ar,bn,de,en,es,fr,hi,it,ja,ko,pt,ru

# Cifrado del módulo GitHub (repos privados). 32 bytes hex.
GIT_ENCRYPTION_KEY=
# Reporte de uso SSH: era metering hacia LP (retirado). Déjalo en false.
SSH_USAGE_REPORT_ENABLED=false
SSH_USAGE_SAMPLE_SECONDS=30

# === Módulo server-alerts (notificaciones del servidor) ===
# Worker que dispara notificaciones programadas (cron) y evalúa reglas por
# métricas sobre sesiones SSH vivas. Ambos tienen default sano (boot OK sin esto).
SERVER_ALERTS_WORKER_ENABLED=true
SERVER_ALERTS_WORKER_INTERVAL_MS=60000
# === Tolqia — audiollamadas con traducción en tiempo real ===
# Motor independiente (pm2 `tolqia`, 127.0.0.1:4500). LUXIPANEL solo integra:
# crea salas/tokens por la API S2S y recibe webhooks firmados. Los secretos
# DEBEN coincidir con `tolqia/server/.env` (`openssl rand -hex 32`).
CALL_ENABLED=true
TOLQIA_URL=http://127.0.0.1:4500
# Prefijo público donde nginx monta Tolqia. Informativo: el navegador abre
# SIEMPRE el `wsUrl` que devuelve POST /v1/calls/tokens (ya lleva el prefijo).
TOLQIA_PUBLIC_PATH=/tolqia
# = TOLQIA_SERVICE_SECRET de tolqia/server/.env (bearer S2S).
TOLQIA_SERVICE_SECRET=
# = WEBHOOK_SECRET de tolqia/server/.env (HMAC de los webhooks entrantes).
TOLQIA_WEBHOOK_SECRET=
# Espejo de RING_TIMEOUT_MS de Tolqia (timeout del timbre en la UI).
CALL_RING_TIMEOUT_MS=45000
