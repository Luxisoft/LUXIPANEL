{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/server.ts", "scripts/**/*.ts", "scripts/**/*.mjs"],
  "project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}"],
  "ignore": ["src/modules/community/installed/**", "**/*.d.ts"],
  "vitest": { "config": ["vitest.config.ts"], "entry": ["src/**/*.test.ts", "src/**/*.spec.ts"] },
  "ignoreDependencies": ["@rollup/rollup-linux-x64-gnu", "pino-pretty"]
}
