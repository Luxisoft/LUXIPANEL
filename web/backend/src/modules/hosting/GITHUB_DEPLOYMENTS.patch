+        run(['/usr/bin/systemctl','set-property','user-'+str(user.pw_uid)+'.slice','MemoryMax=4096M','CPUQuota=150%','TasksMax=1536'])
+        run(['/usr/bin/systemctl','start','user@'+str(user.pw_uid)+'.service'])
