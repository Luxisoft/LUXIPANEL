    {
      "module": "firewall",
      "collection": "rules",
      "source": "system-collector",
      "defaultIntervalSeconds": 600,
      "projection": null,
      "collector": "collector-firewall",
      "scoped": false,
      "scopeField": null,
      "writable": true
    },
    {
      "module": "backup",
      "collection": "schedules",
      "source": "sidecar-mirror",
      "defaultIntervalSeconds": 900,
      "projection": null,
      "collector": null,
      "scoped": false,
      "scopeField": null,
      "writable": false
    }
  ]
