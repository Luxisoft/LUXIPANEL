        "createdAt"
      ],
      "collector": null,
      "scoped": false,
      "scopeField": null,
      "writable": false
    },
    {
      "module": "webhooks",
      "collection": "webhooks",
      "source": "sidecar-mirror",
      "defaultIntervalSeconds": 600,
      "projection": null,
      "collector": null,
      "scoped": false,
      "scopeField": null,
      "writable": false
    },
    {
      "module": "webhooks",
      "collection": "api-keys",
      "source": "sidecar-mirror",
      "defaultIntervalSeconds": 600,
      "projection": [
        "id",
        "name",
        "prefix",
        "createdAt",
        "lastUsedAt"
      ],
      "collector": null,
      "scoped": false,
      "scopeField": null,
      "writable": false
    },
    {
      "module": "nginx",
      "collection": "sites",
      "source": "system-collector",
      "defaultIntervalSeconds": 600,
      "projection": [
        "name",
        "file",
