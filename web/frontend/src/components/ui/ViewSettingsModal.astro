---
// SPDX-License-Identifier: AGPL-3.0-only
// Copyright (C) 2026 LUXISOFT
import { getMessages } from "@/i18n";
import { localeFromRequest } from "@/i18n/server";
import ModalNavbar from "@/components/ui/ModalNavbar.astro";
interface Props {
  id: string;
  title: string;
  buttonLabel?: string;
  description?: string;
  hideFooter?: boolean;
  hideTrigger?: boolean;
  /** "drawer" = full-height flex body (left-nav layouts); "modal" = classic scroll body. */
  variant?: "modal" | "drawer";
}

const locale = localeFromRequest(Astro.request);
const t = await getMessages(locale, ["components"]);
const vsm = t.components.viewSettingsModal;

const {
  id,
  title,
  buttonLabel = vsm.buttonLabel,
  description = vsm.description,
  hideFooter = false,
  hideTrigger = false,
  variant = "modal",
} = Astro.props;
const isDrawer = variant === "drawer";

const triggerId = `${id}-trigger`;
const closeId = `${id}-close`;
const cancelId = `${id}-cancel`;
const hasFooterSlot = Astro.slots.has("footer");
import { DIALOG_CHROME } from "@/lib/ui-classes";
---

<div
  data-view-settings-modal
  data-dialog-id={id}
  data-trigger-id={triggerId}
  data-close-id={closeId}
  data-cancel-id={cancelId}
  class="contents"
>
  {!hideTrigger && (
  <button
    type="button"
    id={triggerId}
    class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-muted/20 px-2.5 py-1.5 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
    aria-label={buttonLabel}
    title={buttonLabel}
  >
    <i class="ti ti-settings text-sm"></i>
    <span>{buttonLabel}</span>
  </button>
  )}

  <dialog
    id={id}
    data-lxp-module-settings
    data-lxp-modal-wide={isDrawer ? "" : undefined}
    class={`w-[min(95vw,72rem)] max-w-5xl ${DIALOG_CHROME}`}
  >
    <ModalNavbar title={title} description={description} closeId={closeId} closeLabel={vsm.close}>
      <Fragment slot="actions">
        <slot name="header-actions" />
      </Fragment>
    </ModalNavbar>
    <div class={isDrawer ? "flex min-h-0 flex-1 overflow-hidden" : "max-h-[80vh] overflow-y-auto px-6 py-5"}>
      <slot />
    </div>
    {(!hideFooter || hasFooterSlot) && (
      <div class="flex items-center justify-end gap-3 border-t border-border px-6 py-4">
        {hasFooterSlot ? (
          <slot name="footer" />
        ) : (
          <button id={cancelId} type="button" class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-accent">
            {vsm.close}
          </button>
        )}
      </div>
    )}
  </dialog>
</div>

<script type="module" src="/scripts/extracted/components/ui/view-settings-modal.js?v=20260928-sections"></script>
