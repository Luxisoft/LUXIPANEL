---
const { p } = Astro.props;
const limits = [['diskQuotaMb','disk',256,1073741824],['maxDomains','domains',0,1000000],['maxEmailAccounts','emails',0,1000000],['maxDatabases','databases',0,1000000],['maxSubUsers','subusers',0,10000],['cpuPercent','cpu',1,10000],['memoryMb','memory',64,1048576],['maxProcesses','processes',8,65536]];
const security = [['maxTerminalSessions','maxSessions',1,20],['commandTimeoutSeconds','timeout',1,3600],['sessionHours','sessionHours',0.1,720]];
---
<dialog id="hosting-plans-dialog" aria-labelledby="hosting-plans-title" class="w-[min(64rem,calc(100vw-2rem))] max-h-[90dvh] rounded-2xl border border-border bg-card p-0 text-foreground shadow-2xl backdrop:bg-black/60">
  <header class="flex items-center justify-between gap-3 border-b border-border p-5"><div><h2 id="hosting-plans-title" class="text-lg font-semibold">{p.title}</h2><p class="mt-1 max-w-2xl text-xs leading-relaxed text-muted-foreground">{p.hint}</p></div><button id="hosting-plans-close" type="button" aria-label={p.close} class="rounded-lg border border-border px-3 py-2">×</button></header>
  <div class="grid gap-5 p-5 md:grid-cols-[13rem_1fr]">
    <aside class="space-y-3"><button id="hosting-plan-new" type="button" class="w-full rounded-lg border border-border px-3 py-2 text-sm">{p.new}</button><div id="hosting-plan-list" class="space-y-2" aria-label={p.title}></div><p id="hosting-plan-capabilities" class="text-xs leading-relaxed text-muted-foreground"></p></aside>
    <form id="hosting-plan-form" class="min-w-0 space-y-4">
      <p id="hosting-plan-status" role="status" class="text-sm text-muted-foreground"></p>
      <fieldset id="hosting-plan-fields" disabled class="min-w-0 space-y-4 disabled:opacity-60">
        <label class="block text-sm">{p.name}<input id="hosting-plan-name" required minlength="2" maxlength="100" class="mt-1 w-full rounded-lg border border-border bg-background p-2" /></label>
        <details open class="rounded-xl border border-border p-3"><summary class="cursor-pointer text-sm font-semibold">{p.permissions}</summary><div id="hosting-plan-permissions" class="mt-3 space-y-2"></div></details>
        <details class="rounded-xl border border-border p-3"><summary class="cursor-pointer text-sm font-semibold">{p.limits}</summary><div class="mt-3 grid grid-cols-2 gap-3">{limits.map(([key,label,min,max]) => <label class="text-xs">{p[label]}<input data-plan-limit={key} required type="number" min={min} max={max} class="mt-1 w-full rounded-lg border border-border bg-background p-2 tabular-nums" /></label>)}</div></details>
        <details class="rounded-xl border border-border p-3"><summary class="cursor-pointer text-sm font-semibold">{p.paths}</summary><div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">{[['allowPaths','allowed'],['denyPaths','denied'],['readOnlyPaths','readonly']].map(([key,label]) => <label class="text-xs">{p[label]}<textarea data-plan-path={key} rows="3" spellcheck="false" class="mt-1 w-full rounded-lg border border-border bg-background p-2 font-mono"></textarea></label>)}<label class="text-xs">{p.defaultPath}<input id="hosting-plan-default-path" class="mt-1 w-full rounded-lg border border-border bg-background p-2 font-mono" /></label></div></details>
        <details class="rounded-xl border border-border p-3"><summary class="cursor-pointer text-sm font-semibold">{p.commands}</summary><div id="hosting-plan-command-groups" class="mt-3 grid grid-cols-2 gap-2 text-xs"></div><div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">{[['allowCommands','allowCommands'],['denyCommands','denyCommands']].map(([key,label]) => <label class="text-xs">{p[label]}<textarea data-plan-command={key} rows="3" spellcheck="false" class="mt-1 w-full rounded-lg border border-border bg-background p-2 font-mono"></textarea></label>)}</div></details>
        <details class="rounded-xl border border-border p-3"><summary class="cursor-pointer text-sm font-semibold">{p.security}</summary><div class="mt-3 grid grid-cols-2 gap-3"><label class="text-xs">{p.shell}<select id="hosting-plan-shell" class="mt-1 w-full rounded-lg border border-border bg-background p-2"><option value="disabled">{p.disabled}</option><option value="jailed">{p.jailed}</option></select></label>{security.map(([key,label,min,max]) => <label class="text-xs">{p[label]}<input data-plan-security={key} type="number" required min={min} max={max} step={key === 'sessionHours' ? 0.1 : 1} class="mt-1 w-full rounded-lg border border-border bg-background p-2" /></label>)}</div><label class="mt-3 flex items-center gap-2 text-xs"><input id="hosting-plan-mfa" type="checkbox" />{p.mfa}</label><label class="mt-3 block text-xs">{p.mailTargets}<textarea id="hosting-plan-mail-targets" rows="2" spellcheck="false" class="mt-1 w-full rounded-lg border border-border bg-background p-2 font-mono"></textarea></label></details>
        <footer class="flex items-center justify-between gap-3"><button id="hosting-plan-delete" type="button" class="rounded-lg border border-destructive/40 px-3 py-2 text-sm text-destructive">{p.delete}</button><button type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">{p.save}</button></footer>
      </fieldset>
    </form>
  </div>
</dialog>
