// Registry-driven react-bits effect selector + per-effect control panels.
// One panel per effect; the active one is toggled by the settings script
// (updateBackgroundSettingsVisibility) via the `data-<scope>-effect-panel`
// attribute matching the select value. `scope` selects the persisted key family
// (login → layout_login_*, panel → layout_panel_*) so the same component drives
// both the login background and the panel background, each independently.
import { LOGIN_EFFECTS, DEFAULT_LOGIN_EFFECT_ID } from "@/lib/login-effects/registry";
import type { BackgroundScope } from "@/lib/login-effects/coerce";
import { getMessages } from "@/i18n";
import { localeFromRequest } from "@/i18n/server";
import LoginEffectControl from "./LoginEffectControl.astro";

interface Props {
  activeEffectLabel: string;
  scope?: BackgroundScope;
}
const { activeEffectLabel, scope = "login" } = Astro.props;
const selectId = `s-layout-${scope}-background-type`;
const locale = localeFromRequest(Astro.request);
const t = await getMessages(locale, ['components']);
const defaultSuffix = t.components.loginEffects.defaultSuffix;
---
<div class="space-y-1.5">
  <label class="text-xs font-medium text-muted-foreground uppercase tracking-wide" for={selectId}>
    {activeEffectLabel}
  </label>
  <select
    id={selectId}
    class="w-full h-10 rounded-lg border border-input bg-background px-3 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
  >
    {LOGIN_EFFECTS.map((e) => (
      <option value={e.id}>{e.label}{e.id === DEFAULT_LOGIN_EFFECT_ID ? defaultSuffix : ""}</option>
    ))}
  </select>
</div>

{LOGIN_EFFECTS.map((e) => (
  <div
    id={`layout-${scope}-effect-${e.id}-settings`}
    data-background-effect-panel={e.id}
    data-background-scope={scope}
    class="hidden space-y-3 rounded-lg border border-border/60 p-3"
  >
    <p class="text-xs font-medium text-foreground/90">{e.label}</p>
    {e.requiresWebGpu && (
      <p class="flex items-start gap-1.5 text-xs text-muted-foreground">
        <i class="ti ti-device-desktop-analytics mt-0.5 shrink-0" aria-hidden="true"></i>
        {t.components.loginEffects.webGpuHint}
      </p>
    )}
    <div class="grid gap-3 sm:grid-cols-2">
      {e.props.map((prop) => <LoginEffectControl prop={prop} scope={scope} />)}
    </div>
  </div>
))}
