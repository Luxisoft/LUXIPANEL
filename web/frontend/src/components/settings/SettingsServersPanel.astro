---
// SPDX-License-Identifier: AGPL-3.0-only
// Copyright (C) 2026 LUXISOFT
/**
 * Settings → Servidores tab.
 *
 * The SINGLE SSH target vault (CRUD + TOFU test/approve), moved here from the
 * old `/panel/servers` page and the assistant's "Servers" tab. Data source:
 * `GET /api/servers` (no secrets); mutations `POST/PUT/DELETE /api/servers/:id`;
 * `POST /api/servers/:id/test` → 409 HOST_FINGERPRINT_PENDING_APPROVAL surfaces
 * the fingerprint + approve. Admins manage global targets; non-admins their own
 * private ones (the backend filters per user). This is also the registry the AI
 * agent's servers.* tools resolve against.
 *
 * Wrapper is a `.tab-panel` whose id ENDS WITH "servers" (see settings/tabs.ts
 * activateTab). Lazy-loaded by servers-script1.ts when the tab becomes visible.
 */
import ModalNavbar from "@/components/ui/ModalNavbar.astro";
import DataTable from "@/components/ui/DataTable";
import {
  buildServersTableColumns,
  buildServersTableRowActions,
  buildServersValueBadges,
} from "@/config/tables/servers-table-config";

interface Props { t: any }
const { t } = Astro.props;
const s: any = t.servers ?? {};
const dataTableI18n = t.components?.dataTable;
const tbl = { table: s?.table, common: s?.common, authTypes: s?.authTypes, status: s?.status };
const d = (k: string, fb: string) => (typeof s?.dialog?.[k] === "string" ? s.dialog[k] : fb) as string;
---

<div class="tab-panel hidden" id="panel-servers">
  <div id="servers-root">
    <div class="mb-4 flex justify-between items-start gap-4">
      <p class="text-sm text-muted-foreground max-w-2xl">{s.description}</p>
      <button id="srv-new" class="shrink-0 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm shadow-primary/20 hover:bg-primary/90 active:scale-[0.98]">
        <i class="ti ti-plus text-base"></i>{s.btnNew}
      </button>
    </div>

    <DataTable
      i18n={dataTableI18n}
      client:load
      tableId="servers-table"
      title={s.pageTitle}
      columns={buildServersTableColumns(tbl)}
      data={[]}
      rowActions={buildServersTableRowActions(tbl)}
      valueBadges={buildServersValueBadges(tbl)}
      selectable={false}
    />
  </div>

  <!-- ══ New / edit server dialog ══ -->
  <dialog id="dlg-server" class="w-full max-w-lg rounded-2xl border border-border bg-card p-0 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm">
    <ModalNavbar title={d("titleNew", "Añadir servidor")} titleId="srv-dialog-title" closeId="srv-close" />
    <form id="form-server" class="flex flex-col gap-4 px-6 py-5 max-h-[80vh] overflow-y-auto">
      <div id="srv-error" class="hidden rounded-lg border border-destructive/30 bg-destructive/10 px-4 py-2.5 text-sm text-destructive"></div>

      <div class="space-y-1.5">
        <label class="text-sm font-medium" for="srv-name">{d("name", "Nombre")} <span class="text-destructive">*</span></label>
        <input id="srv-name" type="text" required maxlength="128" placeholder={d("namePlaceholder", "Mi servidor")}
          class="h-10 w-full rounded-lg border border-input bg-background px-3 text-sm placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
      </div>

      <div class="flex gap-3">
        <div class="flex-1 space-y-1.5">
          <label class="text-sm font-medium" for="srv-host">{d("host", "Host o IP")} <span class="text-destructive">*</span></label>
          <input id="srv-host" type="text" required placeholder={d("hostPlaceholder", "203.0.113.10")}
            class="h-10 w-full rounded-lg border border-input bg-background px-3 text-sm placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
        </div>
        <div class="w-24 space-y-1.5">
          <label class="text-sm font-medium" for="srv-port">{d("port", "Puerto")}</label>
          <input id="srv-port" type="number" min="1" max="65535" value="22"
            class="h-10 w-full rounded-lg border border-input bg-background px-3 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
        </div>
      </div>

      <div class="space-y-1.5">
        <label class="text-sm font-medium" for="srv-username">{d("username", "Usuario")} <span class="text-destructive">*</span></label>
        <input id="srv-username" type="text" required placeholder={d("usernamePlaceholder", "root")}
          class="h-10 w-full rounded-lg border border-input bg-background px-3 text-sm placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
      </div>

      <div class="space-y-1.5">
        <label class="text-sm font-medium" for="srv-authtype">{d("authType", "Tipo de autenticación")}</label>
        <select id="srv-authtype"
          class="h-10 w-full rounded-lg border border-input bg-background px-3 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
          <option value="key">{s.authTypes?.key ?? "Clave SSH"}</option>
          <option value="password">{s.authTypes?.password ?? "Contraseña"}</option>
        </select>
      </div>

      <!-- Secret: SSH key -->
      <div id="srv-key-wrap" class="space-y-3">
        <div class="space-y-1.5">
          <label class="text-sm font-medium" for="srv-secret-key">{d("secretKey", "Clave privada SSH")}</label>
          <textarea id="srv-secret-key" rows="4" placeholder={d("secretKeyPlaceholder", "-----BEGIN OPENSSH PRIVATE KEY-----")}
            class="w-full rounded-lg border border-input bg-background px-3 py-2 text-xs font-mono placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"></textarea>
        </div>
        <div class="space-y-1.5">
          <label class="text-sm font-medium" for="srv-passphrase">{d("passphrase", "Passphrase de la clave (opcional)")}</label>
          <input id="srv-passphrase" type="password" autocomplete="new-password" placeholder={d("passphrasePlaceholder", "Passphrase")}
            class="h-10 w-full rounded-lg border border-input bg-background px-3 text-sm placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
        </div>
      </div>

      <!-- Secret: password -->
      <div id="srv-password-wrap" class="hidden space-y-1.5">
        <label class="text-sm font-medium" for="srv-secret-password">{d("secretPassword", "Contraseña")}</label>
        <input id="srv-secret-password" type="password" autocomplete="new-password" placeholder={d("secretPasswordPlaceholder", "Contraseña")}
          class="h-10 w-full rounded-lg border border-input bg-background px-3 text-sm placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
      </div>

      <p id="srv-keep-hint" class="hidden text-xs text-muted-foreground">{d("secretKeepHint", "Déjalo vacío para conservar el secreto actual.")}</p>

      <!-- Panel-to-panel MCP (optional): mark a target that also runs LUXIPANEL
           so the AI agent can reach it over the target's MCP endpoint (typed
           tools + its own permission/audit) instead of raw SSH. -->
      <div class="rounded-lg border border-border/60 bg-muted/20 p-3 space-y-2.5">
        <label class="flex items-center gap-2 text-sm font-medium cursor-pointer">
          <input id="srv-has-luxipanel" type="checkbox" class="h-4 w-4 rounded border-input" />
          {d("hasLuxipanel", "Este servidor también corre LUXIPANEL")}
        </label>
        <div id="srv-luxipanel-url-wrap" class="hidden space-y-1.5">
          <label class="text-xs font-medium text-muted-foreground" for="srv-luxipanel-url">{d("luxipanelBaseUrl", "URL base de su LUXIPANEL")}</label>
          <input id="srv-luxipanel-url" type="url" placeholder="https://panel-b.example.com"
            class="h-9 w-full rounded-lg border border-input bg-background px-3 text-sm placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
          <p class="text-xs text-muted-foreground">{d("pairHint", "Tras guardar, usa la acción 'Emparejar' en la tabla para provisionar la credencial por SSH.")}</p>
        </div>
      </div>

      <div class="flex gap-3 pt-1">
        <button type="button" id="srv-cancel" class="flex-1 rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-accent">{d("btnCancel", "Cancelar")}</button>
        <button type="submit" class="flex-1 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">{d("btnSave", "Guardar")}</button>
      </div>
    </form>
  </dialog>

  <!-- ══ Fingerprint approval dialog ══ -->
  <dialog id="dlg-fingerprint" class="w-full max-w-md rounded-2xl border border-border bg-card p-0 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm">
    <ModalNavbar title={s.fingerprint?.title ?? "Aprobar huella del host"} closeId="fp-close" />
    <div class="flex flex-col gap-4 px-6 py-5">
      <p class="text-sm text-muted-foreground">{s.fingerprint?.intro ?? "Verifica que esta huella SSH corresponde al servidor antes de aprobarla."}</p>
      <code id="fp-value" class="block rounded-lg bg-card border border-border px-3 py-2 text-xs font-mono break-all"></code>
      <div id="fp-error" class="hidden rounded-lg border border-destructive/30 bg-destructive/10 px-4 py-2.5 text-sm text-destructive"></div>
      <div class="flex gap-3 pt-1">
        <button type="button" id="fp-cancel" class="flex-1 rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-accent">{s.common?.cancel ?? "Cancelar"}</button>
        <button type="button" id="fp-approve" class="flex-1 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">{s.fingerprint?.approve ?? "Aprobar"}</button>
      </div>
    </div>
  </dialog>

  <div id="servers-toast" class="fixed bottom-4 right-4 z-50 hidden max-w-xs rounded-xl border border-border bg-card px-4 py-3 shadow-lg">
    <p id="servers-toast-msg" class="text-sm font-medium"></p>
  </div>

  <script id="servers-i18n" type="application/json" set:html={JSON.stringify(s)}></script>
</div>
