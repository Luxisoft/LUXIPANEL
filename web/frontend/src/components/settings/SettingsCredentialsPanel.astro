---
import ModalNavbar from "@/components/ui/ModalNavbar.astro";
const {
  isAdmin, cred, t, credHelp, credGuides,
  TOKEN_CREDENTIALS, STORAGE_CREDENTIALS, CONNECTOR_CREDENTIALS, MANAGED_CREDENTIALS,
} = Astro.props;
import { DIALOG_CHROME } from "@/lib/ui-classes";
---
      {isAdmin && cred && (
        <div id="panel-credentials" class="tab-panel hidden space-y-5" data-lxp-collapse-group>

          <div id="cred-empty" class="hidden rounded-xl border border-dashed border-border bg-card px-5 py-10 text-center text-sm text-muted-foreground">
            <i class="ti ti-key-off mb-2 block text-2xl opacity-60"></i>
            {t.settings.credentials.empty}
          </div>

          <div id="cred-grid" class="grid gap-4 lg:grid-cols-2">
            {TOKEN_CREDENTIALS.map((c) => (
              <div
                id={`cred-card-${c.id}`}
                class="cred-card rounded-xl border border-border bg-card overflow-hidden transition-shadow"
                data-lxp-collapse
                data-cred-card
                data-cred-id={c.id}
                data-cred-gate={c.gate ?? c.id}
                data-cred-base={c.base}
                data-cred-delete={c.del}
                data-cred-test={c.test}
                data-cred-put-key={c.putKey}
                data-cred-set-field={c.setField}
                data-cred-preview-field={c.previewField}>
                <div class="cred-collapse-head group flex cursor-pointer select-none items-center gap-x-4 px-5 py-4 transition-colors hover:bg-muted/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary/30" data-lxp-collapse-toggle role="button" tabindex="0" aria-expanded="false">
                  <div class="flex size-11 flex-none items-center justify-center rounded-lg bg-muted/60 transition-colors group-hover:bg-muted">
                    {c.id === "openclaw" ? (
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="1em" height="1em" fill="currentColor" class="text-base text-foreground" aria-hidden="true"><mask id="oc-claw-eyes"><rect width="120" height="120" fill="#fff"/><circle cx="45" cy="35" r="5.5" fill="#000"/><circle cx="75" cy="35" r="5.5" fill="#000"/></mask><g mask="url(#oc-claw-eyes)"><path d="M60 10 C30 10 15 35 15 55 C15 75 30 95 45 100 L45 110 L55 110 L55 100 C55 100 60 102 65 100 L65 110 L75 110 L75 100 C90 95 105 75 105 55 C105 35 90 10 60 10Z"/><path d="M20 45 C5 40 0 50 5 60 C10 70 20 65 25 55 C28 48 25 45 20 45Z"/><path d="M100 45 C115 40 120 50 115 60 C110 70 100 65 95 55 C92 48 95 45 100 45Z"/></g><path d="M45 15 Q35 5 30 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M75 15 Q85 5 90 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                    ) : (
                      <i class={`ti ${c.icon} text-base text-foreground`}></i>
                    )}
                  </div>
                  <div class="min-w-0 flex-1">
                    <h3 class="truncate text-sm font-semibold">{c.label}</h3>
                    <p class="cred-state mt-0.5 text-xs text-muted-foreground">{t.settings.credentials.statusMissing}</p>
                  </div>
                  <span class="cred-badge inline-flex items-center gap-1 rounded-full border border-border bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                    <i class="ti ti-circle-x text-xs"></i> {t.settings.credentials.statusMissing}
                  </span>
                  <i class="ti ti-chevron-down shrink-0 text-base text-muted-foreground transition-transform duration-200" data-lxp-collapse-chevron></i>
                </div>
                <div class="m-4 overflow-hidden rounded-xl bg-muted/30">
                <div class="cred-tabs flex gap-4 border-b border-border px-5">
                  <button type="button" data-cred-tab="config" class="cred-tab -mb-px border-b-2 border-primary py-2.5 text-xs font-medium text-foreground">{credHelp.tabConfig}</button>
                  <button type="button" data-cred-tab="help" class="cred-tab -mb-px border-b-2 border-transparent py-2.5 text-xs font-medium text-muted-foreground hover:text-foreground">{credHelp.tabHelp}</button>
                </div>
                <div class="cred-pane space-y-2.5 p-5" data-pane="config">
                  <label class="block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                    {t.settings.credentials.tokenLabel}
                  </label>
                  <div class="flex items-center gap-2">
                    <div class="relative flex-1">
                      <input
                        class="cred-input w-full rounded-lg border border-border bg-background px-3 py-2 pr-10 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary/30"
                        type="password"
                        autocomplete="off"
                        placeholder={t.settings.credentials.tokenPlaceholder}
                      />
                      <button
                        type="button"
                        class="cred-toggle absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground hover:text-foreground"
                        aria-label={t.settings.credentials.show}>
                        <i class="ti ti-eye text-base"></i>
                      </button>
                    </div>
                    <button class="cred-save inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 disabled:opacity-50">
                      <i class="ti ti-device-floppy text-base"></i> {t.settings.credentials.save}
                    </button>
                  </div>
                  {c.extraField && (
                    <div>
                      <label class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-muted-foreground">
                        {c.extraField.label}
                      </label>
                      <input
                        class="cred-extra w-full rounded-lg border border-border bg-background px-3 py-2 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary/30"
                        type="text"
                        autocomplete="off"
                        data-cred-extra-key={c.extraField.key}
                        data-cred-extra-get={c.extraField.getField}
                        placeholder={c.extraField.placeholder}
                      />
                    </div>
                  )}
                  {c.hint && <p class="text-xs text-muted-foreground">{c.hint}</p>}
                  {/* Nota viva del contrato genérico: el GET de la tarjeta puede
                      devolver un resumen legible (p.ej. el plan de Tolqia y sus
                      límites) que se pinta aquí y se refresca tras "Probar". */}
                  {c.noteField && (
                    <p class="cred-note hidden rounded-lg bg-background px-3 py-2 text-xs text-muted-foreground" data-cred-note-get={c.noteField}></p>
                  )}
                  <div class="flex flex-wrap items-center gap-2">
                    {c.test && (
                      <button class="cred-test inline-flex items-center gap-1.5 rounded-lg border border-border bg-background px-3 py-1.5 text-xs font-semibold hover:bg-accent disabled:opacity-50">
                        <i class="ti ti-plug-connected text-sm"></i> {t.settings.credentials.test}
                      </button>
                    )}
                    <button class="cred-clear hidden items-center gap-1.5 rounded-lg border border-destructive/30 bg-background px-3 py-1.5 text-xs font-semibold text-destructive hover:bg-destructive/10 disabled:opacity-50">
                      <i class="ti ti-trash text-sm"></i> {t.settings.credentials.clear}
                    </button>
                  </div>
                </div>
                <div class="cred-pane hidden space-y-3 p-5" data-pane="help">
                  {credGuides[c.id]?.steps?.length ? (
                    <ol class="list-decimal space-y-2 pl-4 text-xs leading-relaxed text-muted-foreground">
                      {credGuides[c.id].steps.map((s) => <li>{s}</li>)}
                    </ol>
                  ) : null}
                  {credGuides[c.id]?.docUrl && (
                    <a href={credGuides[c.id].docUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-primary hover:underline">
                      <i class="ti ti-external-link text-sm"></i> {credGuides[c.id].docLabel || credHelp.openLink}
                    </a>
                  )}
                  {/* Segundo enlace opcional: hay proveedores (Tolqia) donde
                      "dónde se crea el token" y "la documentación" son páginas
                      distintas y ambas hacen falta. */}
                  {credGuides[c.id]?.docUrl2 && (
                    <a href={credGuides[c.id].docUrl2} target="_blank" rel="noopener noreferrer" class="ml-4 inline-flex items-center gap-1.5 text-xs text-primary hover:underline">
                      <i class="ti ti-book text-sm"></i> {credGuides[c.id].docLabel2 || credHelp.openLink}
                    </a>
                  )}
                </div>
                </div>
              </div>
            ))}

            {STORAGE_CREDENTIALS.map((c) => (
              <div
                id={`cred-card-${c.provider}`}
                class="cred-card rounded-xl border border-border bg-card overflow-hidden transition-shadow"
                data-lxp-collapse
                data-cred-storage
                data-cred-id={c.provider}
                data-cred-gate={c.gate}
                data-cred-provider={c.provider}>
                <div class="cred-collapse-head group flex cursor-pointer select-none items-center gap-x-4 px-5 py-4 transition-colors hover:bg-muted/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary/30" data-lxp-collapse-toggle role="button" tabindex="0" aria-expanded="false">
                  <div class="flex size-11 flex-none items-center justify-center rounded-lg bg-muted/60 transition-colors group-hover:bg-muted">
                    <i class={`ti ${c.icon} text-base text-foreground`}></i>
                  </div>
                  <div class="min-w-0 flex-1">
                    <h3 class="truncate text-sm font-semibold">{c.label}</h3>
                    <p class="cred-state mt-0.5 text-xs text-muted-foreground">{t.settings.credentials.statusMissing}</p>
                  </div>
                  <span class="cred-badge inline-flex items-center gap-1 rounded-full border border-border bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                    <i class="ti ti-circle-x text-xs"></i> {t.settings.credentials.statusMissing}
                  </span>
                  <i class="ti ti-chevron-down shrink-0 text-base text-muted-foreground transition-transform duration-200" data-lxp-collapse-chevron></i>
                </div>
                <div class="m-4 overflow-hidden rounded-xl bg-muted/30">
                <div class="cred-tabs flex gap-4 border-b border-border px-5">
                  <button type="button" data-cred-tab="config" class="cred-tab -mb-px border-b-2 border-primary py-2.5 text-xs font-medium text-foreground">{credHelp.tabConfig}</button>
                  <button type="button" data-cred-tab="help" class="cred-tab -mb-px border-b-2 border-transparent py-2.5 text-xs font-medium text-muted-foreground hover:text-foreground">{credHelp.tabHelp}</button>
                </div>
                <div class="cred-pane space-y-3 p-5" data-pane="config">
                  <p class="text-xs text-muted-foreground">{c.provider === "r2" ? t.settings.credentials.storage.r2Hint : t.settings.credentials.storage.s3Hint}</p>
                  <div class="grid grid-cols-2 gap-3">
                    {c.provider === "r2" && (
                      <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-muted-foreground">{t.settings.credentials.storage.accountId}</label>
                        <input data-field="accountId" type="text" autocomplete="off" class="cred-sf w-full rounded-lg border border-border bg-background px-3 py-2 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
                      </div>
                    )}
                    <div>
                      <label class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-muted-foreground">{t.settings.credentials.storage.accessKeyId}</label>
                      <input data-field="accessKeyId" type="text" autocomplete="off" class="cred-sf w-full rounded-lg border border-border bg-background px-3 py-2 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
                    </div>
                    <div>
                      <label class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-muted-foreground">{t.settings.credentials.storage.secret}</label>
                      <div class="relative">
                        <input data-field="secretAccessKey" type="password" autocomplete="new-password" placeholder="••••••••" class="cred-sf cred-secret w-full rounded-lg border border-border bg-background px-3 py-2 pr-10 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
                        <button type="button" class="cred-toggle absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground hover:text-foreground" aria-label={t.settings.credentials.show}>
                          <i class="ti ti-eye text-base"></i>
                        </button>
                      </div>
                    </div>
                    {c.provider === "s3" && (
                      <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-muted-foreground">{t.settings.credentials.storage.endpoint}</label>
                        <input data-field="endpoint" type="text" autocomplete="off" placeholder="https://s3.amazonaws.com" class="cred-sf w-full rounded-lg border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
                      </div>
                    )}
                    {c.provider === "s3" && (
                      <div>
                        <label class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-muted-foreground">{t.settings.credentials.storage.region}</label>
                        <input data-field="region" type="text" autocomplete="off" placeholder="us-east-1" class="cred-sf w-full rounded-lg border border-border bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
                      </div>
                    )}
                  </div>
                  <div class="flex flex-wrap items-center gap-2 border-t border-border pt-3">
                    <button class="cred-save inline-flex items-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 disabled:opacity-50">
                      <i class="ti ti-device-floppy text-base"></i> {t.settings.credentials.save}
                    </button>
                    <button class="cred-clear hidden items-center gap-1.5 rounded-lg border border-destructive/30 bg-background px-3 py-2 text-sm font-semibold text-destructive hover:bg-destructive/10 disabled:opacity-50">
                      <i class="ti ti-trash text-base"></i> {t.settings.credentials.clear}
                    </button>
                  </div>
                </div>
                <div class="cred-pane hidden space-y-3 p-5" data-pane="help">
                  {credGuides[c.provider]?.steps?.length ? (
                    <ol class="list-decimal space-y-2 pl-4 text-xs leading-relaxed text-muted-foreground">
                      {credGuides[c.provider].steps.map((s) => <li>{s}</li>)}
                    </ol>
                  ) : null}
                  {credGuides[c.provider]?.docUrl && (
                    <a href={credGuides[c.provider].docUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-primary hover:underline">
                      <i class="ti ti-external-link text-sm"></i> {credGuides[c.provider].docLabel || credHelp.openLink}
                    </a>
                  )}
                </div>
                </div>
              </div>
            ))}

            {CONNECTOR_CREDENTIALS.map((c) => (
              <div
                id={`cred-card-${c.id}`}
                class="cred-card rounded-xl border border-border bg-card overflow-hidden transition-shadow"
                data-lxp-collapse
                data-cred-connector
                data-cred-id={c.id}>
                <div class="cred-collapse-head group flex cursor-pointer select-none items-center gap-x-4 px-5 py-4 transition-colors hover:bg-muted/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary/30" data-lxp-collapse-toggle role="button" tabindex="0" aria-expanded="false">
                  <div class="flex size-11 flex-none items-center justify-center rounded-lg bg-muted/60 transition-colors group-hover:bg-muted">
                    <i class={`ti ${c.icon} text-base text-foreground`}></i>
                  </div>
                  <div class="min-w-0 flex-1">
                    <h3 class="truncate text-sm font-semibold">{c.label}</h3>
                    <p class="cred-state mt-0.5 text-xs text-muted-foreground">{t.settings.credentials.connector.notConnected}</p>
                  </div>
                  <span class="cred-badge inline-flex items-center gap-1 rounded-full border border-border bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                    <i class="ti ti-circle-x text-xs"></i> {t.settings.credentials.connector.notConnected}
                  </span>
                  <i class="ti ti-chevron-down shrink-0 text-base text-muted-foreground transition-transform duration-200" data-lxp-collapse-chevron></i>
                </div>
                <div class="m-4 overflow-hidden rounded-xl bg-muted/30">
                <div class="cred-tabs flex gap-4 border-b border-border px-5">
                  <button type="button" data-cred-tab="config" class="cred-tab -mb-px border-b-2 border-primary py-2.5 text-xs font-medium text-foreground">{credHelp.tabConfig}</button>
                  <button type="button" data-cred-tab="help" class="cred-tab -mb-px border-b-2 border-transparent py-2.5 text-xs font-medium text-muted-foreground hover:text-foreground">{credHelp.tabHelp}</button>
                </div>
                <div class="cred-pane space-y-3 p-5" data-pane="config">
                  <div class="cred-connector-fields grid grid-cols-2 gap-3"></div>
                  <p class="cred-connector-err hidden text-[11px] text-destructive"></p>
                  <div class="flex flex-wrap items-center gap-2 border-t border-border pt-3">
                    <button class="cred-connect inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 disabled:opacity-50">
                      <i class="ti ti-plug-connected text-base"></i> {t.settings.credentials.connector.connect}
                    </button>
                    <button class="cred-disconnect hidden items-center gap-2 rounded-lg border border-destructive/30 bg-background px-4 py-2 text-sm font-semibold text-destructive hover:bg-destructive/10 disabled:opacity-50">
                      <i class="ti ti-plug-off text-base"></i> {t.settings.credentials.connector.disconnect}
                    </button>
                  </div>
                </div>
                <div class="cred-pane hidden space-y-3 p-5" data-pane="help">
                  <ol class="cred-help-steps list-decimal space-y-2 pl-4 text-xs leading-relaxed text-muted-foreground"></ol>
                  <div class="cred-help-link"></div>
                </div>
                </div>
              </div>
            ))}

            {MANAGED_CREDENTIALS.map((c) => (
              <div
                id={`cred-card-${c.id}`}
                class="cred-card rounded-xl border border-border bg-card overflow-hidden transition-shadow"
                data-lxp-collapse
                data-cred-managed
                data-cred-id={c.id}>
                <div class="cred-collapse-head group flex cursor-pointer select-none items-center gap-x-4 px-5 py-4 transition-colors hover:bg-muted/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary/30" data-lxp-collapse-toggle role="button" tabindex="0" aria-expanded="false">
                  <div class="flex size-11 flex-none items-center justify-center rounded-lg bg-muted/60 transition-colors group-hover:bg-muted">
                    <i class={`ti ${c.icon} text-base text-foreground`}></i>
                  </div>
                  <div class="min-w-0 flex-1">
                    <h3 class="truncate text-sm font-semibold">{c.label}</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">{c.summary}</p>
                  </div>
                  <i class="ti ti-chevron-down shrink-0 text-base text-muted-foreground transition-transform duration-200" data-lxp-collapse-chevron></i>
                </div>
                <div class="m-4 overflow-hidden rounded-xl bg-muted/30">
                <div class="space-y-4 p-5">
                  <p class="text-xs text-muted-foreground">{c.hint}</p>
                  <div class="border-t border-border pt-4">
                    {c.href ? (
                      <a href={c.href} class="inline-flex items-center gap-2 rounded-lg border border-border bg-background px-4 py-2 text-sm font-semibold hover:bg-accent">
                        <i class="ti ti-external-link text-base"></i> {t.settings.credentials.manage}
                      </a>
                    ) : (
                      <button class="cred-manage-assistant inline-flex items-center gap-2 rounded-lg border border-border bg-background px-4 py-2 text-sm font-semibold hover:bg-accent">
                        <i class="ti ti-settings text-base"></i> {t.settings.credentials.manage}
                      </button>
                    )}
                  </div>
                </div>
                </div>
              </div>
            ))}
          </div>

          <!-- ── hCaptcha (site key + secret; protege el login del panel) ── -->
          <div id="cred-card-hcaptcha" class="rounded-xl border border-border bg-card overflow-hidden" data-lxp-collapse>
            <div class="cred-collapse-head group flex cursor-pointer select-none items-center gap-x-4 px-5 py-4 transition-colors hover:bg-muted/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary/30" data-lxp-collapse-toggle role="button" tabindex="0" aria-expanded="false">
              <div class="flex size-11 flex-none items-center justify-center rounded-lg bg-muted/60 transition-colors group-hover:bg-muted">
                <i class="ti ti-shield-lock text-base text-foreground"></i>
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="truncate text-sm font-semibold">{t.settings.credentials.hcaptcha.title}</h3>
                <p class="mt-0.5 text-xs text-muted-foreground">{t.settings.credentials.hcaptcha.desc}</p>
              </div>
              <span id="cred-hcaptcha-status" class="inline-flex items-center gap-1 rounded-full border border-border bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                <i class="ti ti-circle-x text-xs"></i> {t.settings.credentials.hcaptcha.statusMissing}
              </span>
              <i class="ti ti-chevron-down shrink-0 text-base text-muted-foreground transition-transform duration-200" data-lxp-collapse-chevron></i>
            </div>
            <div class="m-4 overflow-hidden rounded-xl bg-muted/30">
            <div class="space-y-4 p-5">
              <div class="space-y-1.5">
                <label for="cred-hcaptcha-sitekey" class="block text-xs font-medium uppercase tracking-wide text-muted-foreground">{t.settings.credentials.hcaptcha.sitekeyLabel}</label>
                <input
                  id="cred-hcaptcha-sitekey"
                  type="text"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder={t.settings.credentials.hcaptcha.sitekeyPlaceholder}
                  class="w-full rounded-lg border border-border bg-background px-3 py-2 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
              </div>
              <div class="space-y-1.5">
                <label for="cred-hcaptcha-secret" class="block text-xs font-medium uppercase tracking-wide text-muted-foreground">{t.settings.credentials.hcaptcha.secretLabel}</label>
                <div class="relative">
                  <input
                    id="cred-hcaptcha-secret"
                    type="password"
                    autocomplete="new-password"
                    spellcheck="false"
                    placeholder={t.settings.credentials.hcaptcha.secretPlaceholder}
                    class="w-full rounded-lg border border-border bg-background px-3 py-2 pr-10 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
                  <button
                    type="button"
                    id="cred-hcaptcha-secret-toggle"
                    class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground hover:text-foreground"
                    aria-label={t.settings.credentials.show}>
                    <i class="ti ti-eye text-base"></i>
                  </button>
                </div>
                <p id="cred-hcaptcha-secret-hint" class="hidden text-[11px] text-muted-foreground">{t.settings.credentials.hcaptcha.secretConfigured}</p>
              </div>
              <div class="flex flex-wrap items-center gap-2 border-t border-border pt-3">
                <button id="cred-hcaptcha-save" class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 disabled:opacity-50">
                  <i class="ti ti-device-floppy text-base"></i> {t.settings.credentials.save}
                </button>
              </div>
            </div>
            </div>
          </div>

          <!-- ── Credenciales Git (gestión movida desde el módulo Files) ── -->
          <div id="cred-card-git" class="rounded-xl border border-border bg-card overflow-hidden" data-lxp-collapse>
            <div class="cred-collapse-head group flex cursor-pointer select-none items-center gap-x-4 px-5 py-4 transition-colors hover:bg-muted/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary/30" data-lxp-collapse-toggle role="button" tabindex="0" aria-expanded="false">
              <div class="flex size-11 flex-none items-center justify-center rounded-lg bg-muted/60 transition-colors group-hover:bg-muted">
                <i class="ti ti-key text-base text-foreground"></i>
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="truncate text-sm font-semibold">{t.files.gitCreds.title}</h3>
                <p class="mt-0.5 text-xs text-muted-foreground">{t.files.gitCreds.securityNote}</p>
              </div>
              <i class="ti ti-chevron-down shrink-0 text-base text-muted-foreground transition-transform duration-200" data-lxp-collapse-chevron></i>
            </div>
            <div class="m-4 overflow-hidden rounded-xl bg-muted/30">
            <div class="space-y-4 p-5">
              <!-- Credenciales/identidades git YA configuradas en el servidor
                   (solo lectura, sin secretos): se usan automáticamente para
                   clonar/actualizar repos. `credentials-script1.ts` lo rellena
                   desde GET /api/files/git/detect. -->
              <div id="git-detected" class="space-y-2"></div>
              <div id="git-creds-list" class="max-h-56 overflow-y-auto"></div>
              <form id="form-git-creds" class="flex flex-col gap-2 rounded-xl border border-border bg-background p-3">
                <div class="flex flex-wrap gap-2">
                  <input id="git-cred-label" type="text" placeholder={t.files.gitCreds.placeholderLabel} class="h-9 min-w-0 flex-1 rounded-lg border border-input bg-card px-3 text-sm" />
                  <select id="git-cred-type" class="h-9 rounded-lg border border-input bg-card px-2 text-sm">
                    <option value="https">{t.files.gitCreds.optionHttps}</option>
                    <option value="ssh">{t.files.gitCreds.optionSsh}</option>
                  </select>
                </div>
                <div class="flex flex-wrap gap-2">
                  <input id="git-cred-host" type="text" placeholder={t.files.gitCreds.placeholderHost} class="h-9 min-w-0 flex-1 rounded-lg border border-input bg-card px-3 text-sm" />
                  <input id="git-cred-user" type="text" placeholder={t.files.gitCreds.placeholderUser} class="h-9 min-w-0 flex-1 rounded-lg border border-input bg-card px-3 text-sm" />
                </div>
                <textarea id="git-cred-secret" rows="3" placeholder={t.files.gitCreds.placeholderSecret} class="w-full rounded-lg border border-input bg-card px-3 py-2 font-mono text-xs"></textarea>
                <div class="flex justify-end gap-2">
                  <button type="button" id="git-cred-cancel" class="hidden h-9 rounded-lg border border-border px-4 text-sm font-medium hover:bg-accent">{t.files.gitCreds.btnClose}</button>
                  <button type="submit" id="git-cred-submit" class="h-9 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90">{t.files.gitCreds.btnSave}</button>
                </div>
              </form>
              <!-- Gestor GitHub · SSH (diagnóstico de llaves, test, ~/.ssh/config, core.sshCommand) -->
              <div class="border-t border-border pt-4">
                <button type="button" id="btn-git-ssh-open"
                  class="inline-flex items-center gap-2 rounded-lg border border-border bg-background px-4 py-2 text-sm font-semibold hover:bg-accent">
                  <i class="ti ti-brand-github text-base"></i> {t.repositoryStore.sshDialog.manageButton}
                </button>
              </div>
            </div>
            </div>
          </div>
          <!-- GitHub · SSH manager (migrado desde el módulo repository-store) -->
          <dialog id="dlg-git-creds" class={`fixed inset-auto top-1/2 left-1/2 m-0 h-fit max-h-[calc(100dvh-2rem)] w-full max-w-3xl -translate-x-1/2 -translate-y-1/2 overflow-y-auto ${DIALOG_CHROME}`}>
            <ModalNavbar
              title="GitHub · SSH"
              description={t.repositoryStore.sshDialog.subtitle}
              icon="ti-brand-github"
              closeId="git-creds-close"
              closeLabel={t.repositoryStore.sshDialog.cerrarAriaLabel}
            >
              <Fragment slot="actions">
                <select id="git-ssh-user" title={t.repositoryStore.sshDialog.usuarioLinuxTitle} class="h-9 max-w-[11rem] rounded-lg border border-input bg-background px-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                  <option value="">{t.repositoryStore.sshDialog.usuarioActual}</option>
                </select>
                <button id="git-ssh-refresh" type="button" title={t.repositoryStore.sshDialog.refrescarTitle} class="rounded-lg border border-border p-2 text-muted-foreground hover:bg-accent hover:text-foreground"><i class="ti ti-refresh text-sm"></i></button>
              </Fragment>
            </ModalNavbar>

            <div class="max-h-[calc(100dvh-8rem)] space-y-5 overflow-y-auto px-6 py-5">
              <!-- 1. Environment -->
              <section class="space-y-2">
                <h4 class="flex items-center gap-1.5 text-sm font-medium"><i class="ti ti-folder-search text-base text-primary"></i> {t.repositoryStore.sshDialog.envSection}</h4>
                <div id="git-ssh-env" class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-xs">
                  <div class="text-muted-foreground">{t.repositoryStore.sshDialog.cargando}</div>
                </div>
                <pre id="git-ssh-ls" class="hidden max-h-44 overflow-auto rounded-lg border border-border bg-background px-3 py-2 font-mono text-[11px] leading-relaxed"></pre>
              </section>

              <!-- 2. Test connection -->
              <section class="space-y-2">
                <h4 class="flex items-center gap-1.5 text-sm font-medium"><i class="ti ti-plug-connected text-base text-primary"></i> {t.repositoryStore.sshDialog.testSection}</h4>
                <div class="flex flex-wrap items-center gap-2">
                  <input id="git-ssh-host" type="text" value="github.com" class="h-9 w-40 rounded-lg border border-input bg-background px-3 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
                  <select id="git-ssh-test-key" title={t.repositoryStore.sshDialog.keySelectTitle} class="h-9 min-w-[12rem] flex-1 rounded-lg border border-input bg-background px-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="">{t.repositoryStore.sshDialog.keyAutoOption}</option>
                  </select>
                  <label class="flex items-center gap-1.5 text-xs text-muted-foreground"><input id="git-ssh-verbose" type="checkbox" class="rounded border-input" /> {t.repositoryStore.sshDialog.verboso}</label>
                  <button id="git-ssh-test-btn" type="button" class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary/90"><i class="ti ti-radar text-sm"></i> {t.repositoryStore.sshDialog.probar}</button>
                </div>
                <div id="git-ssh-test-result" class="hidden rounded-lg border border-border text-sm"></div>
              </section>

              <!-- 3. ~/.ssh/config -->
              <section class="space-y-2">
                <h4 class="flex items-center gap-1.5 text-sm font-medium"><i class="ti ti-settings text-base text-primary"></i> {t.repositoryStore.sshDialog.configSection} (<code class="text-xs">~/.ssh/config</code>)</h4>
                <div id="git-ssh-config-current" class="rounded-lg border border-border bg-muted/30 px-4 py-2.5 text-xs text-muted-foreground">—</div>
                <div class="flex flex-wrap items-center gap-2">
                  <input id="git-ssh-config-hostname" type="text" value="github.com" title="HostName" class="h-9 w-40 rounded-lg border border-input bg-background px-3 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
                  <select id="git-ssh-config-key" title="IdentityFile" class="h-9 min-w-[12rem] flex-1 rounded-lg border border-input bg-background px-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"></select>
                  <button id="git-ssh-config-save" type="button" class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary/90"><i class="ti ti-device-floppy text-sm"></i> {t.repositoryStore.sshDialog.guardar}</button>
                  <button id="git-ssh-fixperms" type="button" title={t.repositoryStore.sshDialog.permisosTitle} class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-border px-3 text-sm hover:bg-accent"><i class="ti ti-lock-cog text-sm"></i> {t.repositoryStore.sshDialog.permisos}</button>
                </div>
                <div id="git-ssh-config-status" class="hidden text-xs"></div>
              </section>

              <!-- 4. Per-repo override -->
              <section class="space-y-2">
                <h4 class="flex items-center gap-1.5 text-sm font-medium"><i class="ti ti-git-branch text-base text-primary"></i> {t.repositoryStore.sshDialog.perRepoSection} (<code class="text-xs">core.sshCommand</code>)</h4>
                <div class="flex flex-wrap items-center gap-2">
                  <input id="git-ssh-repo-path" type="text" placeholder={t.repositoryStore.sshDialog.repoPathPlaceholder} class="h-9 min-w-[14rem] flex-1 rounded-lg border border-input bg-background px-3 font-mono text-xs focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
                  <button id="git-ssh-repo-read" type="button" title={t.repositoryStore.sshDialog.verTitle} class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-border px-3 text-sm hover:bg-accent"><i class="ti ti-eye text-sm"></i> {t.repositoryStore.sshDialog.ver}</button>
                </div>
                <div id="git-ssh-repo-current" class="hidden rounded-lg border border-border bg-muted/30 px-4 py-2 font-mono text-[11px]"></div>
                <div class="flex flex-wrap items-center gap-2">
                  <select id="git-ssh-repo-key" title={t.repositoryStore.sshDialog.llaveParaRepoTitle} class="h-9 min-w-[12rem] flex-1 rounded-lg border border-input bg-background px-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"></select>
                  <button id="git-ssh-repo-apply" type="button" class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary/90"><i class="ti ti-check text-sm"></i> {t.repositoryStore.sshDialog.aplicar}</button>
                  <button id="git-ssh-repo-unset" type="button" class="inline-flex h-9 items-center gap-1.5 rounded-lg border border-border px-3 text-sm hover:bg-accent hover:text-destructive"><i class="ti ti-x text-sm"></i> {t.repositoryStore.sshDialog.quitar}</button>
                </div>
                <div id="git-ssh-repo-status" class="hidden text-xs"></div>
              </section>
            </div>
          </dialog>
        </div>
      )}
