---
const { h, hs, pplan } = Astro.props;
const p = hs.groupPolicy;
const quotas = [
  ["diskQuotaMb", h.stats.disk, 256], ["bandwidthQuotaMb", h.stats.bandwidth, 1024],
  ["maxDomains", h.stats.domains, 1], ["maxEmailAccounts", hs.emailAccounts, 0],
  ["maxDatabases", h.stats.databases, 0], ["maxSubUsers", hs.subusers, 0],
];
---
<section data-hosting-settings-view="providers" class="hidden space-y-5">
  <div><h4 class="text-sm font-semibold">{hs.providerConnections}</h4><p class="mt-1 text-xs text-muted-foreground">{hs.providerConnectionsHint}</p></div>
  <div id="hosting-provider-list" class="space-y-2 text-sm" aria-live="polite"></div>
  <p id="hosting-provider-status" role="status" class="text-xs text-muted-foreground"></p>
  <button id="provider-retry" type="button" class="hidden rounded-lg border border-border px-3 py-2 text-xs">{hs.retry}</button>
  <form id="hosting-provider-form" class="space-y-4 border-t border-border pt-5">
    <fieldset id="provider-fields" disabled class="space-y-4 disabled:opacity-60">
      <h5 id="provider-form-title" class="text-sm font-semibold">{hs.newProvider}</h5>
      <div class="grid grid-cols-1 gap-3 @xl:grid-cols-2">
        <label class="block text-xs">{h.modal.labelName}<input id="provider-name" required maxlength="120" class="mt-1 w-full rounded-lg border border-border bg-background px-2 py-2" placeholder="Luxisoft" /></label>
        <label class="block text-xs">{hs.managedServer}<select id="provider-target" required class="mt-1 w-full rounded-lg border border-border bg-background px-2 py-2"><option value="local">{hs.localServer}</option></select></label>
        <label class="block text-xs">{hs.panelHttpsOrigin}<input id="provider-panel-url" required type="url" class="mt-1 w-full rounded-lg border border-border bg-background px-2 py-2" placeholder="https://backend.luxipanel.com" /></label>
        <label class="block text-xs">{hs.siteEngine}<input id="provider-upstream" required class="mt-1 w-full rounded-lg border border-border bg-background px-2 py-2" value="http://127.0.0.1:3400" /></label>
      </div>
      <label class="block text-xs">{pplan.title}<select id="provider-template-id" class="mt-1 w-full rounded-lg border border-border bg-background px-2 py-2"><option value="">{pplan.legacy}</option></select><span class="mt-1 block text-muted-foreground">{pplan.hint}</span></label>
      <div class="rounded-xl border border-border p-3 space-y-3">
        <div><h6 class="text-sm font-semibold">{p.templateTitle}</h6><p class="mt-1 text-xs text-muted-foreground">{p.templateHint}</p></div>
        <div id="provider-module-picker" class="max-h-96 space-y-2 overflow-y-auto overscroll-contain" aria-label={hs.accountModules}></div>
      </div>
      <details class="rounded-xl border border-border p-3">
        <summary class="cursor-pointer text-sm font-medium">{p.filesScope}</summary>
        <p class="mt-2 text-xs text-muted-foreground">{p.relativeHint}</p>
        <div class="mt-3 grid grid-cols-1 gap-3 @xl:grid-cols-2">
          {[["allowPaths",p.allowPaths],["denyPaths",p.denyPaths],["readOnlyPaths",p.readOnlyPaths]].map(([key,label]) => <label class="block text-xs">{label}<textarea id={`provider-${key}`} rows="3" spellcheck="false" class="mt-1 w-full rounded-lg border border-border bg-background px-2 py-2 font-mono text-xs"></textarea></label>)}
          <label class="block text-xs">{p.defaultPath}<input id="provider-defaultPath" class="mt-1 w-full rounded-lg border border-border bg-background px-2 py-2 font-mono text-xs" placeholder="." /></label>
        </div>
      </details>
      <details class="rounded-xl border border-border p-3">
        <summary class="cursor-pointer text-sm font-medium">{p.commands}</summary>
        <label class="mt-3 flex items-center gap-2 text-xs"><input id="provider-allowAllCommands" type="checkbox" />{p.allowAllCommands}</label>
        <fieldset class="mt-3"><legend class="text-xs font-medium">{p.commandGroups}</legend><div id="provider-command-groups" class="mt-2 grid grid-cols-1 gap-2 text-xs @xl:grid-cols-2"></div></fieldset>
        <div class="mt-3 grid grid-cols-1 gap-3 @xl:grid-cols-2">
          {[["allowCommands",p.allowedCommands],["denyCommands",p.deniedCommands]].map(([key,label]) => <label class="block text-xs">{label}<textarea id={`provider-${key}`} rows="3" spellcheck="false" class="mt-1 w-full rounded-lg border border-border bg-background px-2 py-2 font-mono text-xs"></textarea></label>)}
        </div>
      </details>
      <details class="rounded-xl border border-border p-3">
        <summary class="cursor-pointer text-sm font-medium">{h.modal.resourcesTitle}</summary>
        <div class="mt-3 grid grid-cols-1 gap-3 text-xs @xl:grid-cols-2">
          <label>{h.modal.labelPlan}<select id="provider-plan" class="mt-1 w-full rounded-lg border border-border bg-background px-2 py-2">{[["basic",h.options.planBasic],["pro",h.options.planPro],["business",h.options.planBusiness],["custom",h.options.planCustom]].map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
          {quotas.map(([key,label,min]) => <label>{label}<input id={`provider-${key}`} type="number" min={min} max={key === "diskQuotaMb" ? 10000000 : key === "bandwidthQuotaMb" ? 100000000 : 100000} required class="mt-1 w-full rounded-lg border border-border bg-background px-2 py-2" /></label>)}
        </div>
        <label class="mt-3 flex items-center gap-2 text-xs"><input id="provider-jailEnabled" type="checkbox" />{h.modal.labelJail}</label>
      </details>
      <fieldset class="space-y-2"><legend class="text-xs font-medium">{hs.apiOperations}</legend><div id="provider-operations" class="grid grid-cols-1 gap-2 text-xs @xl:grid-cols-2"></div></fieldset>
      <div class="flex flex-wrap gap-2">
        <button id="provider-submit" type="submit" class="rounded-lg bg-primary px-3 py-2 text-xs font-semibold text-primary-foreground">{hs.createProviderKey}</button>
        <button id="provider-cancel-edit" type="button" class="hidden rounded-lg border border-border px-3 py-2 text-xs">{h.modal.btnCancel}</button>
      </div>
    </fieldset>
  </form>
  <div id="hosting-provider-key-box" class="hidden rounded-lg border border-amber-500/40 bg-amber-500/10 p-3 text-xs"><p class="font-semibold">{hs.copyKeyNow}</p><code id="hosting-provider-key" class="mt-2 block break-all select-all"></code></div>
</section>
