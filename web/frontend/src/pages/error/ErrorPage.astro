import BaseLayout from "@/layouts/BaseLayout.astro";
import DbLogo from "@/components/layout/DbLogo.astro";
import ErrorActions from "@/components/layout/ErrorActions.astro";
import { getPageMessages } from "@/pages/_page-context";

type ErrorKey = "error400" | "error401" | "error403" | "error404" | "error500" | "error503";

interface Props {
  errorKey: ErrorKey;
}

const { errorKey } = Astro.props;

const t = await getPageMessages(Astro, ['errors']);
const error = t.errors[errorKey];
---

<BaseLayout title={`${error.code} - ${error.title}`}>
  <div class="flex min-h-screen flex-col items-center justify-center bg-background px-4 text-center">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute left-1/2 top-1/3 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/5 blur-3xl"></div>
    </div>

    <div class="relative space-y-6">
      <div class="mx-auto flex h-24 w-24 items-center justify-center">
        <DbLogo role="primary" class="h-full w-full object-contain" />
      </div>

      <div>
        <p class="text-8xl font-bold tracking-tight text-primary/20">{error.code}</p>
        <h1 class="mt-2 text-2xl font-semibold">{error.title}</h1>
        <p class="mt-2 text-sm text-muted-foreground max-w-sm mx-auto">
          {error.description}
        </p>
      </div>

      <ErrorActions />
    </div>
  </div>
</BaseLayout>
