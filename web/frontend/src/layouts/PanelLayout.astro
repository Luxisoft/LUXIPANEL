      (() => {
        // React hydrates the module host after the shell. Keep early menu clicks
        // in this document instead of navigating to a second full panel page.
        let pending = null;
        let fallback;
        const stop = () => {
          document.removeEventListener("click", capture, true);
          window.removeEventListener("lxp:internal-modules:ready", ready);
          if (fallback) clearTimeout(fallback);
        };
        const ready = () => {
          stop();
          if (pending?.isConnected) pending.click();
        };
        const capture = (event) => {
          if (window.__lxpInternalModules) { stop(); return; }
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const link = event.target?.closest?.("#sidebar a[data-module], #sidebar-mobile a[data-module], #panel-home-module-links a[href]");
