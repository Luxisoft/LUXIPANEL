<!-- Detección de WebView (misma heurística que FloatingTerminalDrawer): marca
     <html> con .lxp-webview. is:inline para correr temprano; se re-aplica en
     cada navegación SPA vía astro:page-load (los <script type=module> no se
     re-evalúan en swaps). El <html> persiste entre swaps, pero re-aplicar es
     idempotente y cubre cualquier reset. -->
<script is:inline>
  (function () {
    // App desktop (webview Electron): UA "LPSDesktopWebFrame…"/"electron",
    // window.electronApi, o ?lxp_source=desktop|webframe (lo añade la app al
    // cargar la URL). Una vez detectado se memoiza: tras navegación SPA el query
    // param puede perderse, pero la UA es estable. Misma heurística que
    // ui-sync.js (detectUiClientSource).
    function isDesktopApp() {
      if (window.__lxpDesktopApp) return true;
      try {
        var ua = navigator.userAgent || "";
        var qp = "";
        try {
          var sp = new URLSearchParams(location.search);
          qp = (sp.get("lxp_source") || sp.get("source") || sp.get("clientSource") || "").toLowerCase();
        } catch (e) { /* no-op */ }
        var hit =
          /lpsdesktopwebframe|electron/i.test(ua) ||
          !!window.electronApi ||
          qp === "desktop" ||
          qp === "webframe";
        if (hit) window.__lxpDesktopApp = true;
        return hit;
      } catch (e) { return false; }
    }
    function applyClientClasses() {
      try {
        var wv = /ReactNativeWebView/i.test(navigator.userAgent) || !!window.ReactNativeWebView;
        document.documentElement.classList.toggle("lxp-webview", wv);
        document.documentElement.classList.toggle("lxp-desktop-app", isDesktopApp());
      } catch (e) { /* no-op */ }
    }
    applyClientClasses();
    if (!window.__lxpWebviewClassWired) {
      window.__lxpWebviewClassWired = true;
      document.addEventListener("astro:page-load", applyClientClasses);
    }
  })();

</script>
