/**
 * PanelLayout Ã¢â‚¬â€ main dashboard layout with sidebar navigation.
 * Requires authentication (middleware ensures user is set in locals).
 */

import InternalModuleHost from "@/components/workspace/InternalModuleHost";
import { moduleHostLabels } from "@/components/workspace/module-host-labels";
import BaseLayout from "./BaseLayout.astro";
// Reestilo global: convierte los <dialog> nativos del panel en drawer lateral
// izquierdo (opt-out con `data-lxp-modal-keep`). 100% presentacional.
import "@/styles/motion.css";
import "@/styles/modal-drawer.css";
import "@/styles/reactbits-kit.css";
import DbLogo from "@/components/layout/DbLogo.astro";
import { getInitials, canSeeSidebar as canSeeSidebarItem, hasAction } from "@/lib/auth";
import { getMessages } from '@/i18n';
import { localeFromRequest } from '@/i18n/server';
import { LOCALES } from '@/i18n/config';
import ConfirmModal from "@/components/ui/ConfirmModal.astro";
import ModalNavbar from "@/components/ui/ModalNavbar.astro";
import { DIALOG_CHROME } from "@/lib/ui-classes";
import FloatingTerminal from "@/components/floating-terminal/FloatingTerminal.astro";
import FloatingAssistant from "@/components/floating-assistant/FloatingAssistant.astro";
import ReleaseBanner from "@/components/panel-releases/ReleaseBanner";
import InstallationApiKey from "@/components/layout/InstallationApiKey";
import AssistantView from "@/components/floating-assistant/AssistantView";
import ServerRailLive from "@/components/layout/ServerRailLive";
import "@/styles/panel-workspace.css";
import "@/styles/settings-credentials.css";
import { loadLayoutRuntimeContext, parseLayoutBoolean } from "@/lib/layout-context";
import { SERVER_SWITCHER_ID, ATTR_CURRENT_TARGET_ID, ATTR_CURRENT_BRIDGE_SESSION_ID, LOCAL_TARGET_SCOPE } from "@/lib/api-client";
import { DEFAULT_LOGIN_EFFECT_ID } from "@/lib/login-effects/registry";
import { pathIsTerminalView } from "@/lib/panel-routes";
import LoginEffectIsland from "@/components/login-effects/LoginEffectIsland.tsx";
import { resolveLoginEffect } from "@/lib/login-effects/resolve";

interface Props {
  title: string;
  activeModule?: string;
  /** The named title-actions slot renders its own title beside its controls. */
  titleInActions?: boolean;
  /**
   * Full-bleed content: quita el `p-5` del `<main>` para que la página llene
   * todo el área de contenido sin margen (conserva la holgura inferior móvil
   * `pb-14` para no quedar bajo la barra de navegación fija). Lo usa el Terminal.
   */
  fullBleed?: boolean;
  /**
   * Como `fullBleed` pero TAMBIÉN elimina la holgura inferior (`max-lg:pb-14` y
   * el padding-bottom que la CSS de webview reinyecta), para que la página llene
   * el 100% del alto del contenedor SIN padding ni margen inferior. Lo usa la
   * vista del Asistente IA (que tiene su propia barra inferior). Implica
   * `fullBleed`. En webview sólo conserva el safe-area-inset (gesture bar).
   */
  flush?: boolean;
}

const { title, activeModule: requestedActiveModule, titleInActions = false, fullBleed = false, flush = false } = Astro.props;
// Embed mode (`?embed=1`): render only the page content — no sidebar, no
// topbar. Used to show a full panel page (e.g. the mailbox) inside an iframe
// hosted in a left drawer. Chrome is hidden via the inline style block below.
const embed = false;
const activeModule = "assistant";
// El drawer de módulos carga Terminal en un iframe `?embed=1`. Esa vista
// necesita sus assets y listeners aunque el resto del chrome siga oculto.
const terminalModuleEmbed = embed && pathIsTerminalView(Astro.url.pathname) && !Astro.url.searchParams.has("settingsOverlay");
// `flush` implica contenido full-bleed.
const bleed = fullBleed || flush;
const user = Astro.locals.user;
const initials = user ? getInitials(user) : "?";
const canSee = (item: string): boolean => (user ? canSeeSidebarItem(user, item) : false);
const canAccessSettings = canSee("settings");
const canAccessUsers = canSee("users");
// Shell features now gatable per group (admins/sudo pass via canSeeSidebar).
const canSeeNotifications = canSee("notifications");
const canSeeSearch = canSee("search");
const canSeeServerSwitcher = canSee("server-switcher");
// Conmutado a un target remoto (≠ "local"/vacío): el selector se OCULTA (no se
// puede conmutar remoto→remoto desde la UI) y aparece el botón "Regresar" (vuelve
// a la sesión local). El script runtime mantiene ambos estados sincronizados tras
// cada navegación SPA.
const isRemoteTarget = Boolean(user?.targetId && user.targetId !== LOCAL_TARGET_SCOPE);
// Floating terminal button: gated by the per-group "terminal" permission
// (admins always pass via the terminal.* wildcard in their matrix).
const canSeeTerminal = user ? hasAction(user, "terminal.open") && (user.kind === "admin" || (user.hostingPolicy?.runtime && user.hostingPolicy.state === "ready" && user.hostingPolicy.security?.shell === "jailed")) : false;
const canLoadInstalledModules = Boolean(user);

// Server selector: show the SUBDOMAIN of the current panel host (easy to
// identify) instead of the cryptic license name (targetName, e.g. "LXP-…").
// Mirrors extractSubdomain() in server-switcher.ts for the other options.
const subdomainOf = (host: string | null | undefined): string | null => {
  if (!host) return null;
  const first = String(host).trim().toLowerCase().replace(/^https?:\/\//, "").split("/")[0]?.split(":")[0] ?? "";
  if (!first) return null;
  return first.split(".").filter(Boolean)[0] ?? first;
};
const currentHost = Astro.request.headers.get("x-forwarded-host") ?? Astro.request.headers.get("host") ?? "";
// Prefer the SUBDOMAIN saved in LP's DB (`accessSubdomain`/custom domain,
// carried as `targetHost`) over the request host — the latter is the dynamic,
// rotating SSO login-link subdomain (a cryptic throwaway token), not the
// server the user registered. Fall back to the request host, then targetName.
const currentServerLabel = subdomainOf(user?.targetHost) || subdomainOf(currentHost) || user?.targetName || "";
const sidebarPermissions = user?.permissions?.sidebar ?? [];
const isAdminUser = user?.kind === "admin";
const showTitleSettingsAction = Boolean(activeModule) && !["assistant", "settings", "preferences", "repository-store"].includes(activeModule ?? "");
// Each route owns its title and settings controls. Recreate the topbar when
// either the route or locale changes so a persisted header cannot show the
// previous page's title or drawer trigger.
const locale = localeFromRequest(Astro.request);
const topbarPersistKey = `topbar-v3-${activeModule ?? "default"}-${locale}-${Astro.url.pathname}`;
// Detección del slot `title-actions`. Astro 6 `.slots.has()` puede devolver
// `false` si el slot va envuelto en `<div slot="…">`, así que verificamos
// también si Astro renderizó contenido para ese slot (`Astro.slots.render()`
// devuelve "" cuando el slot está vacío). Si AMBAS fallan, un cliente-side
// fallback (más abajo) oculta el link por CSS para que no se vea duplicado.
let hasTitleActionsSlot = false;
try {
  hasTitleActionsSlot = Astro.slots.has("title-actions");
} catch {
  hasTitleActionsSlot = false;
}
if (!hasTitleActionsSlot) {
  try {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const renderedSlot = await (Astro.slots as any).render("title-actions");
    if (typeof renderedSlot === "string" && renderedSlot.trim().length > 0) {
      hasTitleActionsSlot = true;
    }
  } catch {
    /* ignore */
  }
}
const t = await getMessages(locale, ['panelLayout', 'common', 'components']);
// LUXIPANEL is standalone: logout always returns to this panel's own /login.
const directSession = Boolean(user?.direct);
const canUseAssistant = canSee("assistant");
// One panel shell for every user. Groups decide which content can be opened.
const workspaceShell = !embed;
const moduleDrawerOpen = false;
const initialConversationId = Astro.url.searchParams.get("c");
const initialProviderId = Astro.url.searchParams.get("provider");
const assistantInitialOpen = initialConversationId && /^[A-Za-z0-9_-]{1,128}$/.test(initialConversationId)
  ? { conversationId: initialConversationId, provider: initialProviderId && /^[a-z0-9-]{1,32}$/.test(initialProviderId) ? initialProviderId : null }
  : null;

// ── Panel (app) background effect (registry-driven, scope="panel") ──────────
// Configured in Settings → Diseño → "Fondo del panel". Off by default; when on,
// a fixed react-bits layer is rendered behind the whole shell (sidebar/topbar
// are already translucent so it shows through). Mirrors AuthLayout's login
// background but reads the independent `layout_panel_*` settings family.
const { layoutSettings } = await loadLayoutRuntimeContext(Astro.request, Astro.locals.uiBootstrap);
const panelBackgroundEnabled = parseLayoutBoolean(layoutSettings.layout_panel_background_enabled, false);
const panelBackgroundFallbackColor = layoutSettings.layout_panel_background_fallback_color || "";
const { effect: panelEffect, props: panelEffectProps } = resolveLoginEffect(layoutSettings, "panel");
const showPanelBackground = panelBackgroundEnabled && Boolean(panelEffect);

// Sidebar is now two-section: "Módulos" (injected at runtime from the
// enabled module catalog by PanelLayout-define-vars-script1.ts) and
// "Herramientas". Dashboard, Usuarios and the other dedicated entries used
// to live in their own groups; they're catalog modules now and surface in
// the Módulos group when enabled.
// Home = módulo Agentes IA (`/panel` == `/`). Se renderiza en SSR como primer
// ítem del grupo "Módulos" para que exista y esté resaltado desde el primer
// byte, sin depender del fetch a /api/modules/installed ni de la versión
// cacheada del script del layout. El resto de módulos los inyecta el script
// dentro de este mismo grupo (`data-injected`), y `updateActiveNav()` sigue
// siendo la fuente de verdad tras los swaps SPA (transition:persist).
const showHomeModuleLink = canLoadInstalledModules;
const homeLinkClass = [
  "sidebar-mod-link flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium transition-all duration-150",
  activeModule === "assistant" ? "bg-primary/10 text-primary" : "text-muted-foreground hover:bg-accent hover:text-foreground",
].join(" ");
const navGroups = [
  {
    label: t.panelLayout.groups.tools,
    items: [
      ...(canSee("modules")
        ? [{ icon: "ti-puzzle", label: t.panelLayout.nav.modules, href: "/modules", module: "modules" }]
        : []),
      ...(canAccessSettings
        ? [{ icon: "ti-settings", label: t.panelLayout.nav.settings, href: "/settings", module: "settings" }]
        : []),
    ],
  },
];
const workspaceToolGroups = navGroups.map((group) => ({
  ...group,
  items: group.items.filter((item) => item.module !== "settings"),
})).filter((group) => group.items.length > 0);
---

<BaseLayout title={title} includeClientRouter={true}>
  {Astro.locals.uiBootstrap && <script type="application/json" id="lxp-ui-bootstrap" set:html={JSON.stringify(Astro.locals.uiBootstrap).replace(/</g, "\\u003c")} />}
  <script>import "@/lib/ui-events";</script>
  {!embed && showPanelBackground && (
    <div
      id="panel-bg-layer"
      class="fixed inset-0 z-0 pointer-events-none"
      style={panelBackgroundFallbackColor ? `background:${panelBackgroundFallbackColor}` : undefined}
      aria-hidden="true"
    >
      <LoginEffectIsland client:load effectId={panelEffect?.id ?? DEFAULT_LOGIN_EFFECT_ID} effectProps={panelEffectProps} />
    </div>
  )}
{embed && (
    <style is:inline set:html={"[data-embed] #sidebar,[data-embed] #sidebar-mobile{display:none !important}[data-embed] [data-panel-topbar]{display:flex !important;position:relative !important;inset:auto !important;z-index:1 !important;flex:none !important;height:auto !important;min-height:3.25rem;padding:.45rem .85rem;border-top:0 !important;border-bottom:1px solid var(--border);background:var(--card)}[data-embed] [data-panel-topbar]:has(>div:first-of-type>h1:only-child){display:none !important}[data-embed] [data-panel-topbar]>button,[data-embed] [data-panel-topbar]>div:not(:first-of-type),[data-embed] #panel-topbar-title{display:none !important}[data-embed] [data-panel-topbar]>div:first-of-type{display:flex;flex-wrap:wrap;gap:.5rem}[data-embed] [data-panel-content]{padding:0 !important;min-height:0;height:auto !important;overflow:auto !important}[data-embed] [data-panel-content]>:first-child{min-height:100%}"} />
  )}
  <div data-embed={embed ? "" : undefined} data-workspace-shell={workspaceShell ? "" : undefined} data-workspace-assistant={workspaceShell ? String(canUseAssistant) : undefined} data-user-initials={initials} data-workspace-admin={workspaceShell ? String(isAdminUser) : undefined} data-workspace-security-audit={workspaceShell ? String(canSee("security-audit")) : undefined} data-workspace-local={workspaceShell ? String(!user?.targetId || user.targetId === "local") : undefined} class={`flex h-screen overflow-hidden ${showPanelBackground ? "relative z-10 bg-transparent" : "bg-background"}`}>

    <!-- Ã¢â€â‚¬Ã¢â€â‚¬ Sidebar Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
    {!embed && <aside
      id="sidebar"
      transition:persist="sidebar"
      class:list={["hidden lg:flex shrink-0 flex-col border-r border-border bg-card/50 backdrop-blur-sm transition-[width,opacity,border-color] duration-200 ease-out", workspaceShell ? "lxp-workspace-modules" : "w-60"]}
    >
      <!-- Logo + fecha/hora del servidor conectado -->
      <div class:list={["flex min-h-14 items-center gap-3 border-b border-border px-4 py-2", workspaceShell && "lxp-workspace-modules-heading"]}>
        {workspaceShell && <div class="lxp-workspace-modules-controls ml-auto flex items-center gap-1" data-hide-in-desktop>
          <button type="button" class="lxp-modules-theme-control" aria-label={t.panelLayout.actions.switchTheme} title={t.panelLayout.actions.switchTheme}>
            <i class="ti ti-sun text-base lxp-modules-theme-sun" aria-hidden="true"></i>
            <i class="ti ti-moon text-base lxp-modules-theme-moon" aria-hidden="true"></i>
          </button>
          <label class="lxp-modules-language-control" aria-label={t.common.language}>
            <select id="workspace-language-select" aria-label={t.common.language}>
              {LOCALES.map((entry) => <option value={entry.code} selected={locale === entry.code}>{entry.label}</option>)}
            </select>
            <i class="ti ti-chevron-down text-xs" aria-hidden="true"></i>
          </label>
        </div>}
        {!workspaceShell && <>
        <DbLogo role="sidebar" alt={t.panelLayout.logoAlt ?? t.components?.logoAlt ?? "LUXIPANEL"} class="h-8 w-auto shrink-0 object-contain" />
        <div
          id="sidebar-server-clock"
          class="flex min-w-0 flex-col text-[11px] leading-tight text-muted-foreground"
          title={t.panelLayout.clock.serverTimeTitle}
          aria-live="polite"
        >
          <span class="truncate font-medium text-foreground" data-clock-date>--</span>
          <span class="truncate tabular-nums">
            <span data-clock-time class="font-mono">--:--:--</span>
            <span data-clock-tz class="ml-1 text-muted-foreground/80"></span>
          </span>
        </div>
        </>}
      </div>

      <!-- Navigation -->
      <nav class="flex-1 overflow-y-auto p-2 space-y-4" aria-label={t.panelLayout.groups.modules}>
        {(showHomeModuleLink || workspaceShell) && (
          <div id="nav-modules-group">
            {!workspaceShell && <p class="mb-1 px-3 text-[10px] font-semibold uppercase tracking-widest text-muted-foreground/60">{t.panelLayout.groups.modules}</p>}
            <div class="space-y-0.5">
              {!workspaceShell && <a href="/panel" data-module="assistant" data-home-link aria-current={activeModule === "assistant" ? "page" : undefined} title={t.panelLayout.nav.assistant} class={homeLinkClass}>
                <span class="lxp-workspace-nav-icon"><i class="ti ti-robot text-base"></i></span>
                <span>{t.panelLayout.nav.assistant}</span>
              </a>}
            </div>
          </div>
        )}
        {!workspaceShell && navGroups.filter((group) => group.items.length > 0).map((group) => (
          <div>
            <p class="mb-1 px-3 text-[10px] font-semibold uppercase tracking-widest text-muted-foreground/60">
              {group.label}
            </p>
            <div class="space-y-0.5">
              {group.items.map((item) => (
                <a
                  href={item.href}
                  aria-current={activeModule === item.module ? "page" : undefined}
                  class:list={[
                    "sidebar-mod-link flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium transition-all duration-150",
                    activeModule === item.module
                      ? "bg-primary/10 text-primary"
                      : "text-muted-foreground hover:bg-accent hover:text-foreground",
                  ]}
                >
                  <span class="lxp-workspace-nav-icon"><i class={`ti ${item.icon} text-base`}></i></span>
                  <span>{item.label}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>

      {workspaceShell && canSee("monitor") && <div class="lxp-modules-usage">
        <ServerRailLive client:only="react" />
        <div id="server-rail-network"></div>
        <div id="server-cli-usage"></div>
      </div>}

      {workspaceShell && workspaceToolGroups.map((group) => (
        <section class="lxp-workspace-tools" aria-label={group.label}>
          <div class="space-y-0.5">
            {group.items.map((item) => (
              <a href={item.href} data-module={item.module} aria-current={activeModule === item.module ? "page" : undefined} title={item.label} class:list={["sidebar-mod-link flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium transition-all duration-150", activeModule === item.module ? "bg-primary/10 text-primary" : "text-muted-foreground hover:bg-accent hover:text-foreground"]}>
                <span class="lxp-workspace-nav-icon"><i class={`ti ${item.icon} text-base`}></i></span>
                <span>{item.label}</span>
              </a>
            ))}
          </div>
        </section>
      ))}

      <!-- Footer: server selector + logout -->
      <div id="workspace-relocatable-footer" class:list={["border-t border-border p-3 space-y-2", workspaceShell && "lxp-workspace-modules-footer"]}>
        {canSeeServerSwitcher && (
          <label id="server-switcher-wrap" class:list={["block", isRemoteTarget && "hidden"]}>
            <span class="sr-only">{t.panelLayout.serverSwitcher.label}</span>
            <div class="relative">
              <i class="ti ti-server-2 absolute left-2.5 top-1/2 -translate-y-1/2 text-sm text-muted-foreground pointer-events-none"></i>
              <select
                id={SERVER_SWITCHER_ID}
                {...{ [ATTR_CURRENT_TARGET_ID]: user?.targetId ?? "" }}
                {...{ [ATTR_CURRENT_BRIDGE_SESSION_ID]: user?.bridgeSessionId ?? "" }}
                disabled={isRemoteTarget}
                aria-disabled={isRemoteTarget}
                class="w-full truncate rounded-lg border border-border bg-background pl-8 pr-2 py-2 text-xs font-medium text-foreground outline-none hover:bg-accent cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
                title={t.panelLayout.serverSwitcher.title}
              >
                {user?.targetId ? (
                  <Fragment>
                    { /* Conectado a un target remoto: la semilla seleccionada ES el
                         target activo (su label real, NO disfrazado de "Local"), y
                         se añade la opción "Local (este servidor)" para poder volver.
                         El script eager reemplaza esta lista con el contrato completo. */ }
                    <option value={user.targetId} selected>{currentServerLabel || user?.targetName || user.targetId}</option>
                    <option value="__local__">{t.panelLayout.serverSwitcher.localOption}</option>
                  </Fragment>
                ) : (
                  <option value="__local__" selected>{t.panelLayout.serverSwitcher.localOption}</option>
                )}
              </select>
            </div>
          </label>
        )}
        {canSeeServerSwitcher && (
          <button
            id="server-return-local"
            data-server-return
            class:list={[
              "flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-all duration-150 hover:bg-accent hover:text-foreground",
              !isRemoteTarget && "hidden",
            ]}
            title={t.panelLayout.serverSwitcher.returnTitle}
          >
            <i class="ti ti-arrow-back-up text-base"></i>
            <span>{t.panelLayout.serverSwitcher.returnButton}</span>
          </button>
        )}
        <div class:list={["lxp-session-actions", workspaceShell && "lxp-session-actions-workspace"]}>
          {workspaceShell && canAccessSettings && (
            <a href="/settings" class="lxp-session-settings" aria-label={t.panelLayout.nav.settings} title={t.panelLayout.nav.settings}>
              <i class="ti ti-settings text-base" aria-hidden="true"></i>
            </a>
          )}
          <button
            id="logout-btn"
            class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-all duration-150 hover:bg-destructive/10 hover:text-destructive"
          >
            <i class="ti ti-logout text-base"></i>
            <span>{t.panelLayout.actions.closeSession}</span>
          </button>
        </div>
      </div>
    </aside>}

    <!-- Ã¢â€â‚¬Ã¢â€â‚¬ Main content Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ -->
    {workspaceShell && <aside id="server-context-rail" transition:persist="server-context-rail" class="lxp-workspace-server-rail hidden lg:flex shrink-0 flex-col border-r border-border bg-card/90 backdrop-blur-sm">
      <div class="flex min-h-14 items-center gap-3 border-b border-border px-4 py-2">
        <DbLogo role="sidebar" alt={t.panelLayout.logoAlt ?? t.components?.logoAlt ?? "LUXIPANEL"} class="h-8 w-auto shrink-0 object-contain" />
        <div id="sidebar-server-clock" class="flex min-w-0 flex-col text-[11px] leading-tight text-muted-foreground" title={t.panelLayout.clock.serverTimeTitle} aria-live="polite">
          <span class="truncate font-medium text-foreground" data-clock-date>--</span>
          <span class="truncate tabular-nums"><span data-clock-time class="font-mono">--:--:--</span><span data-clock-tz class="ml-1 text-muted-foreground/80"></span></span>
        </div>
        <span id="workspace-rail-header-actions" class="lxp-rail-header-actions"></span>
      </div>
      <div class="lxp-server-rail-stack min-h-0 flex-1">
        <div id="server-rail-assistant-nav" class="min-h-0 flex-1"></div>
      </div>
      <div id="server-rail-footer"></div>
    </aside>}

