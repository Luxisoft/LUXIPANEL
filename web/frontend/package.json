{
  "name": "frontend",
  "type": "module",
  "version": "2.0.2",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "@/*": "./dist/*"
  },
  "scripts": {
    "prebuild": "pnpm run i18n:audit && pnpm run i18n:split",
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/predev-kill-port.ps1",
    "dev": "pnpm run i18n:split && astro dev",
    "build": "node scripts/build-extracted.mjs && NODE_OPTIONS=--max-old-space-size=2560 astro build && node scripts/copy-dist-metadata.mjs",
    "redeploy": "pnpm run build && pm2 restart luxipanel-frontend --update-env",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report e2e/report",
    "i18n:split": "node scripts/i18n-split-namespaces.mjs",
    "i18n:audit": "node scripts/i18n-audit-coverage.mjs",
    "check:platform-bindings": "node scripts/check-platform-bindings.mjs",
    "deps:check": "pnpm dlx --package typescript@5.8.3 --package knip@5.30.6 knip --config knip.json --dependencies --no-progress",
    "deps:fix": "pnpm dlx --package typescript@5.8.3 --package knip@5.30.6 knip --config knip.json --dependencies --no-progress --fix",
    "deps:dedupe": "pnpm dedupe",
    "deps:prune": "pnpm prune --prod"
  },
  "packageManager": "pnpm@11.5.0",
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/react": "6.0.6",
    "@astrojs/sitemap": "3.7.4",
    "@dicebear/avataaars": "9.4.2",
    "@dicebear/core": "9.4.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tabler/icons-webfont": "^3.41.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-table": "^8.21.3",
    "@tolqia/client": "file:vendor/tolqia-client-1.0.0.tgz",
    "@tolqia/contracts": "file:vendor/tolqia-contracts-1.0.0.tgz",
    "@tolqia/react": "file:vendor/tolqia-react-1.0.0.tgz",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "animejs": "^4.4.1",
    "astro": "7.2.8",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "face-api.js": "^0.22.2",
    "flatpickr": "^4.6.13",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.7",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.52.2",
    "motion": "^12.43.0",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.1",
    "qrcode": "^1.5.4",
    "quill": "^2.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vgpu": "^0.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.1",
    "@iconify-json/vscode-icons": "^1.2.50",
    "@iconify/utils": "^3.1.3",
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "vite": "^8.0.13"
  }
}
