# ================================
# LUXIPANEL Frontend Configuration
# ================================

HOST=127.0.0.1
PORT=4321
PORT_FRONTEND=4321
BACKEND_URL=http://127.0.0.1:8080
BACKEND_PORT=8080
SITE_URL=https://luxipanel.com
LUXIPANEL_URL=https://luxipanel.com
LUXISOFT_URL=https://luxisoft.com
# true  = disable browser/proxy caching for HTML, extracted scripts, SW, and API responses
# false = allow normal caching
DISABLE_HTTP_CACHE=true
# Allowed hosts for Vite dev server (comma-separated, optional - auto-extracts from SITE_URL if empty)
ALLOWED_HOSTS=luxipanel.com,*.luxipanel.com,panel.luxisoft.com,localhost,127.0.0.1
